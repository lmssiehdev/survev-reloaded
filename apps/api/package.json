{
  "name": "@survev/api",
  "private": true,
  "type": "module",
  "exports": {
    "./types": {
      "types": "./src/types.ts"
    }
  },
  "scripts": {
    "build": "bun ../../scripts/buildApp.ts src/index.ts src/db/migrate.ts && cp -r src/db/drizzle dist/drizzle",
    "typecheck": "bun check",
    "start": "bun --env-file=../../.env dist/index.js",
    "dev": "bun --env-file=../../.env --watch --no-clear-screen src/index.ts",
    "db:generate": "bun --env-file=../../.env --bun drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun --env-file=../../.env src/db/migrate.ts",
    "db:studio": "bun --env-file=../../.env --bun drizzle-kit studio --config=drizzle.config.ts",
    "db:wipe": "bun --env-file=../../.env src/db/wipe.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.8",
    "@hono/zod-validator": "^0.8.0",
    "@survev/config": "workspace:*",
    "@survev/contracts": "workspace:*",
    "@survev/shared": "workspace:*",
    "better-auth": "^1.7.8",
    "better-result": "^3.0.1",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.8",
    "postgres": "^3.4.9",
    "slugify": "^1.6.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "drizzle-kit": "1.0.0-rc.4"
  }
}
