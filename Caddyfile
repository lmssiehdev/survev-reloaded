# survev behind Caddy, see HOSTING.md. Values come from .env through docker-compose.yml.
# SURVEV_SCHEME=https (default) gets certificates automatically, http is for local testing.
{
	http_port {$SURVEV_HTTP_PORT:80}
}

(no_private) {
	# /private/* is for the game server and bot over the compose network only
	@private path /private /private/*
	respond @private 404
}

# website + API
{$SURVEV_SCHEME:https}://{$SURVEV_DOMAIN} {
	import no_private
	encode zstd gzip

	@api path /api/* /team_v2
	handle @api {
		# Caddy sets X-Forwarded-For to the client IP (proxyIPHeader in the config)
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		# vite output names are content hashed
		@hashed path /js/* /css/* /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@html path / /stats/ *.html
		header @html Cache-Control "no-cache"
		file_server
	}
}

# game server main port: ping test, and find_game from the API (with the API key)
{$SURVEV_SCHEME:https}://{$SURVEV_GAME_DOMAIN} {
	import no_private
	reverse_proxy game:8001
}

# one site per game port, generated by docker/caddy-run.sh
{$SURVEV_GAME_PORT_SITES} {
	reverse_proxy game:{http.request.local.port}
}
