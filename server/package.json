{
  "name": "@survev/server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rolldown -c rolldown.config.ts",
    "typecheck": "tsc",
    "start:api": "node --enable-source-maps dist/index.js",
    "start:game": "node --enable-source-maps dist/gameServer.js",
    "dev": "bun run --parallel dev:api dev:game",
    "dev:api": "bun --watch --no-clear-screen src/api/index.ts",
    "dev:game": "bun scripts/devWatch.ts src/gameServer.ts ../shared ../survev-config.hjson",
    "db:generate": "drizzle-kit generate --config=src/api/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=src/api/drizzle.config.ts",
    "db:seed": "bun src/api/db/seed.ts",
    "db:studio": "drizzle-kit studio --config=src/api/drizzle.config.ts",
    "db:wipe": "bun src/api/db/wipe.ts",
    "stressTest": "bun src/stressTest.ts",
    "lint": "cd .. && bun run lint"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@hono/zod-validator": "^0.8.0",
    "@oslojs/crypto": "^1.0.1",
    "arctic": "^3.7.0",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.8",
    "nanotimer": "^0.3.15",
    "obscenity": "^0.4.6",
    "pg": "^8.23.0",
    "redis": "^5.12.1",
    "slugify": "^1.6.9",
    "typescript": "^6.0.3",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.69.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/nanotimer": "^0.3.2",
    "@types/node": "~22.12.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "rolldown": "^1.2.9",
    "unique-username-generator": "^1.5.1"
  }
}
