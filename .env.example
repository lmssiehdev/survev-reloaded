# All settings are environment variables. Copy this file to .env (`bun survev-setup` does it with random secrets).
# Dev: the app scripts load the repo root .env, everything has a local default so it can stay empty.
# Docker: docker compose reads it, see HOSTING.md.
# Runtime settings (game modes, client theme, captcha on/off) live in the database, admins change them through /private.

# --- secrets, required in production (random, eg `openssl rand -base64 32`) ---
# the API, game servers and bot call each other's private routes with it
SURVEV_API_KEY=
SURVEV_IP_SECRET=
BETTER_AUTH_SECRET=

# --- API ---
# DATABASE_URL=postgres://survev:survev@127.0.0.1:5432/survev
# API_HOST=0.0.0.0
# API_PORT=8000
# the website's public URL, OAuth redirects come back to it
# PUBLIC_URL=http://127.0.0.1:3000
# where login flows end, an absolute URL when the client is on another subdomain than the API
# CLIENT_URL=/
# header with the client IP when behind a reverse proxy
# PROXY_IP_HEADER=X-Forwarded-For
# leaderboards and stats are cached in redis when set
# REDIS_URL=redis://127.0.0.1:6379
# discord login, redirect URL <PUBLIC_URL>/api/auth/callback/discord
# DISCORD_CLIENT_ID=
# DISCORD_SECRET_ID=
# proxycheck.io, blocks VPNs and proxies
# PROXYCHECK_KEY=
# cloudflare turnstile captcha
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# "Mock login" button that creates test accounts (default: on in dev)
# ALLOW_MOCK_ACCOUNT=false

# --- game server ---
# the game server registers its region with the API, the region list players see comes from those
# REGION=local
# translation key of the region name (index-north-america, index-europe, index-asia, index-south-america, index-korea)
# REGION_L10N=index-local
# public URL of this game server, players connect to it (default http://127.0.0.1:<GAME_PORT>)
# REGION_URL=https://game.example.com
# API_URL=http://127.0.0.1:8000
# GAME_HOST=0.0.0.0
# GAME_PORT=8001
# every game runs on its own port from this range
# GAME_PORTS=9000-9063
# SSL_KEY_FILE=
# SSL_CERT_FILE=
# UNIQUE_IN_GAME_NAMES=true
# dev tools (default: on in dev)
# ALLOW_BOTS=false
# ALLOW_EDIT_MSG=false
# every player spawns at x,y
# SPAWN_POS=400,400
# items every player spawns with, JSON
# DEFAULT_ITEMS={"backpack":"backpack03"}

# --- discord bot (`bun run dev:bot`), also uses API_URL ---
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# members with this role can use the commands
# DISCORD_ROLE_ID=
# spectate links point to it
# PUBLIC_URL=http://127.0.0.1:3000

# --- every server app ---
# LOG_LEVEL=info
# off when the log collector adds its own timestamps (journalctl)
# LOG_DATE=true
# discord webhooks errors are posted to
# ERROR_WEBHOOK_URL=
# CLIENT_ERROR_WEBHOOK_URL=
# rate limits (default: on in production)
# RATE_LIMITS=true

# --- client build, public: VITE_* ends up in the client code ---
# the API's origin when the client is served from another one (game portals)
# VITE_API_URL=https://survev.example.com
# VITE_AD_PREFIX=
# VITE_GAMEMONETIZE_ID=
# VITE_SPELLSYNC_PROJECT_ID=
# VITE_SPELLSYNC_PUBLIC_TOKEN=
# vite dev server port
# CLIENT_PORT=3000

# --- docker-compose.yml only ---
# website and API
SURVEV_DOMAIN=survev.example.com
# the game server, a separate DNS name
SURVEV_GAME_DOMAIN=game.survev.example.com
# same range as GAME_PORTS, opened in the firewall
SURVEV_GAME_PORTS=9000-9063
POSTGRES_PASSWORD=change-me
# local testing without certificates: http on one port, e.g.
# SURVEV_SCHEME=http
# SURVEV_HTTP_PORT=8080
