# copy to .env, docker compose reads it (see HOSTING.md)

# website and API
SURVEV_DOMAIN=survev.example.com
# game server: regions.<id>.address in survev-config.hjson, a separate DNS name
SURVEV_GAME_DOMAIN=game.survev.example.com
# gameServer.firstGamePort .. firstGamePort + maxGames - 1, opened in the firewall
SURVEV_GAME_PORTS=9000-9063

# same as database.password in survev-config.hjson
POSTGRES_PASSWORD=change-me

# config file to use, relative to this directory
# SURVEV_CONFIG=survev-config.hjson

# local testing without certificates: http on one port, e.g.
# SURVEV_SCHEME=http
# SURVEV_HTTP_PORT=8080
