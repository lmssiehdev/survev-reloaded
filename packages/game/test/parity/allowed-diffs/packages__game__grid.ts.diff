+
+    /**
+     * Sets the bit of every object id in the cells overlapping this AABB.
+     * Covers the same cells as intersectAABBSet, without building a Set
+     */
+    markAABB(this: Grid<T & { __id: number }>, aabb: AABB, bits: Uint32Array): void {
+        const min = this._roundToCells(aabb.min);
+        const max = this._roundToCells(aabb.max);
+
+        for (let x = min.x; x <= max.x; x++) {
+            const xRow = this._grid[x];
+            for (let y = min.y; y <= max.y; y++) {
+                const cell = xRow[y];
+                for (const object of cell) {
+                    const id = object.__id;
+                    bits[id >>> 5] |= 1 << (id & 31);
+                }
+            }
+        }
+    }
 }
 
