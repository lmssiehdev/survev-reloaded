{
  "name": "survev",
  "version": "0.4.3",
  "type": "module",
  "description": "Open Source Surviv.io Server",
  "workspaces": [
    "server",
    "shared",
    "client",
    "bot",
    "tests"
  ],
  "scripts": {
    "survev-setup": "bun install && tsx setup.ts",
    "dev": "concurrently \"bun run dev:api\" \"bun run dev:game\" \"bun run dev:client\"",
    "dev:server": "cd server && bun run dev",
    "dev:api": "cd server && bun run dev:api",
    "dev:game": "cd server && bun run dev:game",
    "dev:client": "cd client && bun run dev",
    "build": "cd server && bun run build && cd ../client && bun run build",
    "stressTest": "cd server && bun run stressTest",
    "lint": "oxlint --fix; dprint fmt",
    "lint:ci": "oxlint; dprint check"
  },
  "engines": {
    "bun": ">=1.4.4-canary.1"
  },
  "author": "Leia",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "@types/hjson": "^2.4.6",
    "@types/node": "~22.12.0",
    "concurrently": "^10.0.5",
    "dprint": "^0.55.2",
    "oxlint": "^1.85.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "enquirer": "^2.4.1",
    "hjson": "^3.2.2",
    "tsx": "^4.23.15"
  },
  "packageManager": "bun@1.4.4-canary.1",
  "trustedDependencies": [
    "@taufik-nurrohman/color-picker",
    "canvas",
    "dprint",
    "esbuild",
    "sharp",
    "workerd"
  ]
}
